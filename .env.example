USERSERVICE_APP_HOST=userservice-app
USERSERVICE_APP_PORT=8080
USERSERVICE_DB_HOST=userservice-db
USERSERVICE_DB_NAME=userservice_db
USERSERVICE_DB_INTERNAL_PORT=5432
USERSERVICE_DB_EXTERNAL_PORT=54322
USERSERVICE_DB_USER=userservice_db_user
USERSERVICE_DB_PASS=userservice_db_pass
USERSERVICE_DB_TABLE_PREFIX="userservice."
JWT_SECRET=replace-with-a-strong-random-secret
KAFKA_BROKER=broker:29092

BOOKSERVICE_APP_HOST=bookservice-app
BOOKSERVICE_APP_PORT=8081
BOOKSERVICE_DB_HOST=bookservice-db
BOOKSERVICE_DB_NAME=bookservice_db
BOOKSERVICE_DB_INTERNAL_PORT=5432
BOOKSERVICE_DB_EXTERNAL_PORT=54323
BOOKSERVICE_DB_USER=bookservice_db_user
BOOKSERVICE_DB_PASS=bookservice_db_pass
BOOKSERVICE_DB_TABLE_PREFIX="bookservice."

LOANSERVICE_APP_HOST=loanservice-app
LOANSERVICE_APP_PORT=8082
LOANSERVICE_DB_HOST=loanservice-db
LOANSERVICE_DB_NAME=loanservice_db
LOANSERVICE_DB_INTERNAL_PORT=5432
LOANSERVICE_DB_EXTERNAL_PORT=54324
LOANSERVICE_DB_USER=loanservice_db_user
LOANSERVICE_DB_PASS=loanservice_db_pass
LOANSERVICE_DB_TABLE_PREFIX="loanservice."

APIGATEWAYSERVICE_APP_HOST=apigateway-app
APIGATEWAYSERVICE_APP_PORT=8084
SENTRY_DSN=replace-with-your-sentry-dsn

# Jaeger tracing (R-027). Applies to all services; omit to use the defaults.
# Sampling probability in [0.0, 1.0]; invalid/empty falls back to 1.0.
JAEGER_SAMPLE_RATE=1.0
JAEGER_HOST_PORT=jaeger:6831
# JAEGER_SERVICE_NAME is set per service in code (user-service, book-service,
# loan-service, apigateway-service). Setting it here would override every
# service with the same name, so it is intentionally left unset.

GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-admin-password